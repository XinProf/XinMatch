data_brucite_MgOH2
# ---------------------------------------------------------------------------
# Brucite Mg(OH)2, hand-built standard structure for the test_xrd 4-1
# benchmark.  Space group P -3 m 1 (No.164), hexagonal setting.
# Cell a=3.147 A, c=4.769 A.  Mg on 1a (0,0,0); O on 2d (1/3,2/3,0.22).
# U_iso set to realistic thermal values (0.005-0.007 A^2).
# ---------------------------------------------------------------------------
_chemical_name_common       'brucite'
_chemical_formula_sum       'Mg H2 O2'
_cell_length_a              3.147
_cell_length_b              3.147
_cell_length_c              4.769
_cell_angle_alpha           90.0
_cell_angle_beta            90.0
_cell_angle_gamma           120.0
_cell_volume                40.86
_cell_formula_units_Z       1
_symmetry_cell_setting      trigonal
_symmetry_space_group_name_H-M  'P -3 m 1'
_space_group_IT_number      164
