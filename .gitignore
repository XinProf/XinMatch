.DS_Store
Thumbs.db
desktop.ini

# ---- Project-specific ----
# Large reference databases (COD SQLite, ICDD PDF) — distributed separately
*.db3
*.sqlite
*.sqlite3
# COD reference databases (data/*.db, 512–942 MB — far beyond GitHub limits;
# distributed separately. NOTE: *.db must never be committed — v1.3.1 已用
# git-filter-repo 从全部历史移除 cod_full/cod_full_curated/cod_inorganics)
data/*.db
*.bak-*.db
# v3 列存参考库（*.xinDB，110 MB–1.7 GB）—— 由 XinMatch-DataBase 仓库分发，
# 便携包构建时才由 tools/build_exe.ps1 打进 data/，源码树永不提交。
data/*.xinDB
*.xinDB
# Proprietary commercial XRD database files (not redistributed)
*.mti
*.mqs
*.mqn
*.mtb
*.mtn
*.mtu
# Large XRD data files / fixtures (keep only small synthetic ones in repo)
tests/fixtures/patterns/**/*.raw
tests/fixtures/patterns/**/*.rd
tests/fixtures/patterns/**/*.udi
tests/fixtures/patterns/**/*.brml
tests/fixtures/patterns/**/*.ras
tests/fixtures/cod/**

# ---- Build artifacts ----
*.spec
# packaging source config (Phase 15) — kept tracked
!xinmatch.spec


# ---- Database backups (large, not for VCS) ----
# ⚠ 目录级规则**必须带前导斜杠**: 写 `data/` 会按任意层级匹配, 可能连带忽略
#   xinmatch/core/db/data/atomic_scattering_params.json —— 而 peak_compute 硬依赖它,
#   漏入仓会让克隆后建库直接 FileNotFoundError。(PolyXRD 侧已踩过这个坑。)
/data/
data/cod_inorganics.bak-*.db
data/*.db.bak-*

# Offline registration key injected at build time; never commit
registration_secret.txt
